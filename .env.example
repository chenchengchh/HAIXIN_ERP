# ============================================
# 海星数字化系统 环境配置模板
# 复制为 .env 后按需修改
#   cp .env.example .env
# ============================================

# ---------- AI 语音服务 ----------
# 语音服务监听端口
VOICE_SERVER_PORT=8000
# 语音模型目录（模型下载方式见 docs/模型下载.md）
MODEL_DIR=/app/models/speech_paraformer-small_asr_nat-zh-cn-16k-common-vocab8404
SERVICE_NAME=ai-voice-service

# ---------- Nacos 注册/配置中心 ----------
NACOS_ADDR=nacos:8848
NACOS_MODE=standalone
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=512m
NACOS_AUTH_ENABLE=false

# ---------- MySQL ----------
# 宿主机映射端口（容器内 3306）
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hxcoe003
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

# ---------- 各业务服务数据库账号（Docker 网络内） ----------
# 服务库命名规则：{svc}_db，账号 {svc}_app，示例：
#   aps:  jdbc:mysql://mysql:3306/aps_db
#   hr:   jdbc:mysql://mysql:3306/hr_db
# 数据库初始化脚本位于 docker/mysql/init/

# ---------- JVM ----------
JVM_XMS=256m
JVM_XMX=512m

# ---------- 前端 ----------
# 本地开发代理目标（指向网关）
VITE_PROXY_TARGET=http://localhost:9000
